{
  "name": "reflect-fivem",
  "productName": "Reflect FiveM",
  "version": "1.8.3",
  "description": "Bibliothèque et installateur de packs graphiques pour FiveM / GTA V (ENB, ReShade, NVE, QuantV, mods .rpf).",
  "author": "clementveillet",
  "license": "MIT",
  "homepage": "https://reflect-fivem.com/application",
  "repository": {
    "type": "git",
    "url": "https://github.com/clmvlt/reflect-fivem.git"
  },
  "bugs": {
    "url": "https://github.com/clmvlt/reflect-fivem/issues"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "devprod": "set PM_API_URL=https://reflect-fivem.com/api&& electron-vite dev",
    "start": "electron-vite build && electron .",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir --publish never",
    "release": "node scripts/release.mjs",
    "release:local": "python deploy/deploy.py"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.8.9",
    "node-unrar-js": "^2.0.2",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/yauzl": "^2.10.3",
    "@vitejs/plugin-react": "^5.0.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
